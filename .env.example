# ─── Application Environment ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# ─── Blockchain Configuration (Ethereum Sepolia Testnet) ──────────────────────
CHAIN_ID=11155111
CHAIN_NAME="Sepolia Testnet"
ETHEREUM_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME="Sepolia Testnet"
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org

# Standard ERC-5564 Announcer contract deployment address (Sepolia).
# Replace with the actual deployed address once confirmed.
NEXT_PUBLIC_ERC5564_ANNOUNCER_ADDRESS=0x0000000000000000000000000000000000000000
ERC5564_ANNOUNCER_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Supabase Configuration ────────────────────────────────────────────────────
# How to find these values:
#   Supabase Dashboard → Project Settings → API → Project URL and Keys

# Public / browser-safe credentials (safe to expose in client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only credentials — NEVER expose to the browser or commit real values.
# Used by API route handlers and the scanner worker only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Direct PostgreSQL connection string.
# Used for running SQL migrations or direct connection pooling (optional).
# Format: postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ─── Scanner Worker Configuration ─────────────────────────────────────────────
# scanner_id must match the value seeded in scanner_checkpoints (default: "default")
SCANNER_ID=default
SCAN_INTERVAL_MS=15000
SCAN_BLOCK_BATCH_SIZE=100
SCAN_CONFIRMATION_BLOCKS=2
SCAN_START_BLOCK=0

# ─── Database Migration Notes ─────────────────────────────────────────────────
# No ORM (Prisma/Drizzle) is used. Migrations are plain SQL files.
# Apply migrations in order via the Supabase SQL Editor:
#   1. packages/db/supabase/migrations/001_initial.sql
#   2. packages/db/supabase/migrations/002_bitgo_mpc_wallet_metadata.sql
#   3. packages/db/supabase/migrations/003_stealth_pay_ethereum_schema.sql
# See docs/database-architecture.md for full instructions.

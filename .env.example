# ─── Application Environment ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# ─── Whitechain Testnet (Primary Settlement Network) ─────────────────────────
WHITECHAIN_CHAIN_ID=2625
WHITECHAIN_CHAIN_NAME="Whitechain Testnet"
WHITECHAIN_RPC_URL="https://rpc-testnet.whitechain.io"
WHITECHAIN_EXPLORER_URL="https://testnet.whitechainsentry.com"
NEXT_PUBLIC_WHITECHAIN_ROUTER_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_WHITECHAIN_ANNOUNCER_ADDRESS="0x0000000000000000000000000000000000000000"

# ─── Arkiv Network (Decentralized State Layer) ─────────────────────────────────
ARKIV_NETWORK="testnet"
ARKIV_STORAGE_TTL_HOURS=168

# ─── Ethereum Sepolia / ENS / Uniswap ─────────────────────────────────────────
CHAIN_ID=11155111
CHAIN_NAME="Sepolia Testnet"
ETHEREUM_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME="Sepolia Testnet"
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_ERC5564_ANNOUNCER_ADDRESS=0x0000000000000000000000000000000000000000
ERC5564_ANNOUNCER_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Arc by Circle (Secondary Settlement Network) ─────────────────────────────
ARC_CHAIN_ID=5042
ARC_RPC_URL="https://testnet.arc.circle.com"

# ─── Supabase Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ─── Scanner Worker Configuration ─────────────────────────────────────────────
SCANNER_ID=default
SCAN_INTERVAL_MS=15000
SCAN_BLOCK_BATCH_SIZE=100
SCAN_CONFIRMATION_BLOCKS=2
SCAN_START_BLOCK=0
